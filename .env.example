# Base de données PostgreSQL
# Pour Vercel Postgres: obtenez l'URL dans https://vercel.com/dashboard/storage/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/cook?schema=public"

# NextAuth.js - Google Provider
GOOGLE_CLIENT_ID="votre_client_id_google"
GOOGLE_CLIENT_SECRET="votre_client_secret_google"

# NextAuth.js - Email Provider (optionnel)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="votre_email@gmail.com"
EMAIL_SERVER_PASSWORD="votre_mot_de_passe_app"
EMAIL_FROM="votre_email@gmail.com"

# NextAuth.js - Secret (générez-en un avec: openssl rand -base64 32)
NEXTAUTH_SECRET="votre_secret_aleatoire_32_caracteres"

# NextAuth.js - URL du site
NEXTAUTH_URL="http://localhost:3000"
